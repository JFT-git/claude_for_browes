{
    admin off
}

# Replace __DOMAIN__ with your domain (e.g. claude.example.com)
# Replace __BASIC_AUTH_HASH__ with: caddy hash-password --plaintext 'yourpassword'
__DOMAIN__ {
    # Public asset proxy path: NO basic_auth (assets are public JS/CSS/fonts).
    # This avoids 401 on dynamic import() where the browser does not send Authorization.
    @assets path /p/assets-proxy.anthropic.com/* /p/assets.claude.ai/*
    handle @assets {
        reverse_proxy gateway:8088
    }

    # Everything else requires basic_auth
    route {
        header {
            >Strict-Transport-Security "max-age=31536000"
            >X-Content-Type-Options "nosniff"
            >X-Frame-Options "DENY"
            >Referrer-Policy "strict-origin-when-cross-origin"
            -Server
        }
        basic_auth {
            __BASIC_AUTH_USER__ __BASIC_AUTH_HASH__
        }
        @desktop path /desktop /desktop/*
        reverse_proxy @desktop browser:3000
        @proxy path /p /p/*
        reverse_proxy @proxy gateway:8088
        reverse_proxy gateway:8088
    }

    handle_errors 401 {
        header {
            Strict-Transport-Security "max-age=31536000"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "strict-origin-when-cross-origin"
            -Server
        }
        respond "" 401
    }
}
