{
    # Admin API only on a socket inside the container (tmpfs, root-only), so
    # add-user.sh/remove-user.sh can reload users without dropping connections.
    admin unix//run/caddy/admin.sock
    # Runtime errors can include complete requests even without access logging.
    # Keep diagnostics, but never persist magic-link URLs or request headers.
    log default {
        format filter {
            request>uri delete
            request>headers delete
            wrap json
        }
    }
    # Only TLS on 443 has a PROXY header. HTTP-01 on public 80 stays direct.
    servers :443 {
        listener_wrappers {
            proxy_protocol {
                timeout 5s
                allow {$FRONTDOOR_IP}/32
                fallback_policy reject
            }
            tls
        }
        # Real client IP behind Cloudflare (used for brute-force protection).
        # If you do not use Cloudflare these ranges are simply never matched.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
}

# Replace __DOMAIN__ with your domain (e.g. claude.example.com)
# Add one basic_auth line per user (use ./add-user.sh). Hash generator:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'the-password'
__DOMAIN__ {
    # gzip/zstd for everything compressible (the gateway talks to Claude uncompressed
    # so it can rewrite URLs; compression for the client happens here).
    encode zstd gzip

    # Internal gateway endpoints (brute-force protection) must never be reachable from outside.
    @internal path /__ban-check /__authfail
    handle @internal {
        respond 404
    }

    # Public privacy policy for the extension listing. No login, so store review can fetch it.
    handle /privacy {
        root * /srv/privacy
        rewrite * /index.html
        header Content-Type text/html;charset=utf-8
        file_server
    }

    # Public asset proxy path: NO basic_auth (assets are public JS/CSS/fonts).
    # Avoids 401 on dynamic import() where the browser does not send Authorization.
    @assets path /p/assets-proxy.anthropic.com/* /p/assets.claude.ai/*
    handle @assets {
        reverse_proxy gateway:8088 {
            # never let a client choose its identity
            header_up -X-Remote-User
        }
    }

    # Browsers apply no header rules to WebSocket handshakes (voice, artifact
    # sync, terminal), so these arrive without the extension's Basic login. The
    # gateway authenticates them with its own signed __Host-gw_ws cookie; the
    # identity header is never taken from the client and bans still apply.
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
        not header Authorization *
        not path /__*
    }
    handle @websocket {
        forward_auth gateway:8088 {
            uri /__ban-check
            header_up X-Client-IP {client_ip}
        }
        reverse_proxy gateway:8088 {
            header_up -X-Remote-User
            header_up -X-Client-IP
        }
    }

    # Everything else requires basic_auth. The authenticated username is passed
    # to the gateway via X-Remote-User so it can pick that user's cookie file.
    route {
        header {
            >Strict-Transport-Security "max-age=31536000"
            >X-Content-Type-Options "nosniff"
            >X-Frame-Options "DENY"
            >Referrer-Policy "strict-origin-when-cross-origin"
            -Server
        }
        # 1) Is this IP banned? (asked BEFORE any password is checked)
        forward_auth gateway:8088 {
            uri /__ban-check
            header_up X-Client-IP {client_ip}
        }
        # 2) Password check
        basic_auth {
            # one line per user:  username  bcrypt-hash
            __BASIC_AUTH_USER__ __BASIC_AUTH_HASH__
        }
        reverse_proxy gateway:8088 {
            header_up X-Remote-User {http.auth.user.id}
        }
    }

    # 3) Every failed password attempt is reported to the gateway (ban after N failures).
    handle_errors 401 {
        header {
            Strict-Transport-Security "max-age=31536000"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            -Server
        }
        rewrite * /__authfail
        reverse_proxy gateway:8088 {
            method POST
            header_up X-Client-IP {client_ip}
        }
    }
}

# The direct CONNECT endpoint uses a public IP certificate. HTTP-01 is available
# on port 80 while frontdoor/gateway wait for the first certificate to exist.
{$CONNECT_HOST} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
            disable_tlsalpn_challenge
        }
    }
    respond 404
}
