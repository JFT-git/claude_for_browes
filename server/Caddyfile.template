{
    admin off
}

# Replace __DOMAIN__ with your domain (e.g. claude.example.com)
# Add one basic_auth line per user. Generate a hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'the-password'
__DOMAIN__ {
    # Public asset proxy path: NO basic_auth (assets are public JS/CSS/fonts).
    # Avoids 401 on dynamic import() where the browser does not send Authorization.
    @assets path /p/assets-proxy.anthropic.com/* /p/assets.claude.ai/*
    handle @assets {
        reverse_proxy gateway:8088 {
            # never let a client choose its identity
            header_up -X-Remote-User
        }
    }

    # Everything else requires basic_auth. The authenticated username is passed
    # to the gateway via X-Remote-User so it can pick that user's cookie file.
    route {
        header {
            >Strict-Transport-Security "max-age=31536000"
            >X-Content-Type-Options "nosniff"
            >X-Frame-Options "DENY"
            >Referrer-Policy "strict-origin-when-cross-origin"
            -Server
        }
        basic_auth {
            # one line per user:  username  bcrypt-hash
            __BASIC_AUTH_USER__ __BASIC_AUTH_HASH__
        }
        reverse_proxy gateway:8088 {
            header_up X-Remote-User {http.auth.user.id}
        }
    }

    handle_errors 401 {
        header {
            Strict-Transport-Security "max-age=31536000"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "strict-origin-when-cross-origin"
            -Server
        }
        respond "" 401
    }
}
