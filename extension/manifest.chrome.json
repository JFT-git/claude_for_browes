{
  "manifest_version": 3,
  "name": "Gateway Connector for Claude",
  "version": "2.0.5",
  "description": "Routes claude.ai through your gateway. Enter your gateway host once \u2014 one build for all domains.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "privacy",
    "alarms",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Gateway"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "minimum_chrome_version": "125",
  "host_permissions": [
    "https://claude.ai/*",
    "https://www.claude.ai/*",
    "https://assets.claude.ai/*",
    "https://assets-proxy.anthropic.com/*",
    "https://api.anthropic.com/*",
    "https://s-cdn.anthropic.com/*",
    "https://a-cdn.anthropic.com/*",
    "https://a.claude.ai/*",
    "https://a-cdn.claude.ai/*",
    "https://*.claudeusercontent.com/*",
    "https://*.claudemcpcontent.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://cdnjs.cloudflare.com/*",
    "https://unpkg.com/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "https://esm.sh/*",
    "https://cdn.tailwindcss.com/*",
    "https://code.jquery.com/*",
    "https://cdn.plot.ly/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "proxy_blocks",
        "enabled": true,
        "path": "proxy-block-rules.json"
      }
    ]
  }
}
