{
  "manifest_version": 3,
  "name": "Gateway Connector for Claude",
  "version": "1.8.4",
  "description": "Routes claude.ai through your gateway. Enter your gateway host once \u2014 one build for all domains.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Gateway"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}