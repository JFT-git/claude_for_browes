{
  "manifest_version": 3,
  "name": "Gateway Connector for Claude",
  "version": "1.8.14",
  "description": "Routes claude.ai through your gateway. Enter your gateway host once \u2014 one build for all domains.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Gateway"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{3f7a9c2e-8b4d-4e1a-9c5f-2d6b8a4e7f1c}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/JFT-git/claude_for_browes/main/updates.json"
    }
  },
  "optional_permissions": [
    "https://*/*"
  ]
}