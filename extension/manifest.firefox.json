{
  "manifest_version": 3,
  "name": "Gateway Connector for Claude",
  "version": "1.8.1",
  "description": "Routes claude.ai through your gateway. Enter your gateway host once \u2014 one build for all domains.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Gateway"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-gateway@example.invalid",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "optional_permissions": [
    "https://*/*"
  ]
}